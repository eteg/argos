{
  "name": "@argos/rdo-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./report.schema.json": "./dist/report.schema.json",
    "./report-content.schema.json": "./dist/report-content.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/export-json-schema.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
