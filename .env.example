# API
PORT=3001
API_KEY=dev-key
DATABASE_URL=postgres://argos:argos@localhost:5432/argos
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use o host da região do projeto: cloud.langfuse.com (UE) ou us.cloud.langfuse.com (EUA).
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Web
# Vazio: o navegador chama /v1 na própria web, que repassa para a API (API_INTERNAL_URL, padrão http://localhost:3001).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_KEY=dev-key

# Pasta dos áudios e fotos enviados
UPLOAD_DIR=uploads

# Transcrição do áudio (a Claude não recebe áudio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
