import { readFileSync } from "node:fs";
import { ROOT, call, check, daysAgo, done, entry, generate, randomUUID, site, today } from "./lib.mts";

// ---- listPendingDays
const tag = randomUUID().slice(0, 6);
const s = await site(`000 Pend ${tag}`);
await entry(s.id, daysAgo(3), 2, { offline: true });
await entry(s.id, daysAgo(3), 1, { offline: true });
await entry(s.id, daysAgo(1), 0, { offline: false });
await entry(s.id, today, 1);
const pd = await call("GET", "/v1/pending-days");
check("pending-days 200", pd.status === 200, pd);
const group = pd.json.items.find((g: any) => g.site.id === s.id);
check("obra aparece", !!group, pd.json.items.map((g: any) => g.site.name));
const days = group?.days ?? [];
check("dias d-3 e d-1, sem hoje, do mais antigo pro mais novo", JSON.stringify(days.map((d: any) => d.localDate)) === JSON.stringify([daysAgo(3), daysAgo(1)]), days);
check("isNext só no mais antigo", days.length === 2 && days[0].isNext === true && days[1].isNext === false, days);
check("contagens do d-3 (2 registros, 2 áudios, 3 fotos, offline)", days[0]?.entriesCount === 2 && days[0]?.audiosCount === 2 && days[0]?.photosCount === 3 && days[0]?.offline === true, days[0]);
check("d-1 offline=false", days[1]?.offline === false, days[1]);
const names = pd.json.items.map((g: any) => g.site.name);
check("grupos em ordem de nome", JSON.stringify(names) === JSON.stringify([...names].sort((a: string, b: string) => a.localeCompare(b))), names);
const summary = (await call("GET", `/v1/sites/${s.id}`)).json;
console.log("     info: getSite.pendingDays =", JSON.stringify(summary.pendingDays));
const gen = await generate(s.id, today);
check("hoje bloqueado por PREVIOUS_DAY_PENDING com os 2 dias", gen.status === 409 && gen.json.code === "PREVIOUS_DAY_PENDING" && gen.json.errors.map((e: any) => e.field).join() === `${daysAgo(3)},${daysAgo(1)}`, gen.json);
check("getSite.pendingDays lista todo dia que bloqueia o de hoje (inclui d-1 online)", summary.pendingDays.some((p: any) => p.localDate === daysAgo(1)), summary.pendingDays);
check("getSite.pendingDays traz offline por dia", JSON.stringify(summary.pendingDays) === JSON.stringify([{ localDate: daysAgo(3), entriesCount: 2, offline: true }, { localDate: daysAgo(1), entriesCount: 1, offline: false }]), summary.pendingDays);
const listed = (await call("GET", "/v1/sites")).json.items.find((x: any) => x.id === s.id);
check("listSites traz os mesmos dias pendentes", JSON.stringify(listed?.pendingDays) === JSON.stringify(summary.pendingDays), listed?.pendingDays);
// obra pausada some da lista
const paused = await site(`000 Pausada ${tag}`);
await entry(paused.id, daysAgo(2), 0, { offline: true });
await call("PUT", `/v1/sites/${paused.id}/status`, { status: "paused" });
check("obra pausada fora do pending-days", !(await call("GET", "/v1/pending-days")).json.items.some((g: any) => g.site.id === paused.id));
check("X-Timezone inválido 400", (await call("GET", "/v1/pending-days", undefined, { "X-Timezone": "Marte/Base" })).status === 400);

// ---- importServices e listServices
const sv = await site(`Serv ${tag}`);
const up = async (buf: Buffer | string, name: string) => { const f = new FormData(); f.append("file", new Blob([buf]), name); return call("PUT", `/v1/sites/${sv.id}/services`, f); };
const x = await up(readFileSync(new URL("data/demo-site/planilha-servicos.xlsx", ROOT)), "planilha-serviços.xlsx");
check("xlsx importa", x.status === 200 && x.json.servicesCount > 0, x);
console.log("     info: xlsx servicesCount =", x.json?.servicesCount, "fileName =", x.json?.servicesFileName);
const c = await up(readFileSync(new URL("data/demo-site/services.csv", ROOT)), "services.csv");
check("csv importa 30 e substitui", c.status === 200 && c.json.servicesCount === 30, c);
const list = await call("GET", `/v1/sites/${sv.id}/services`);
check("lista 30 ordenada por código", list.json.items.length === 30 && list.json.items[0].code === "01.01", list.json.items.slice(0, 2));
check("unidade lida", list.json.items[1].unit === "m²", list.json.items[1]);
const byCode = await call("GET", `/v1/sites/${sv.id}/services?search=02.0`);
check("busca por código", byCode.json.items.length > 0 && byCode.json.items.every((i: any) => i.code.includes("02.0")), byCode.json.items);
const byDesc = await call("GET", `/v1/sites/${sv.id}/services?search=PLACA`);
check("busca sem diferenciar maiúscula", byDesc.json.items.length === 1 && byDesc.json.items[0].code === "01.02", byDesc.json.items);
check("busca com % não vira curinga", (await call("GET", `/v1/sites/${sv.id}/services?search=%25`)).json.items.length === 0);
check("busca com _ não vira curinga", (await call("GET", `/v1/sites/${sv.id}/services?search=_`)).json.items.length === 0);
const after = (await call("GET", `/v1/sites/${sv.id}`)).json;
check("getSite servicesCount e fileName", after.servicesCount === 30 && after.servicesFileName === "services.csv", [after.servicesCount, after.servicesFileName]);
const semCab = await up("a;b\n1;2\n", "x.csv");
check("csv sem código e descrição 422 SPREADSHEET_UNREADABLE", semCab.status === 422 && semCab.json.code === "SPREADSHEET_UNREADABLE", semCab);
const soCab = await up("codigo;descricao\n", "x.csv");
check("csv só com cabeçalho 422", soCab.status === 422 && soCab.json.code === "SPREADSHEET_UNREADABLE", soCab);
const xlsxRuim = await up("não é zip", "x.xlsx");
check("xlsx corrompido 422", xlsxRuim.status === 422 && xlsxRuim.json.code === "SPREADSHEET_UNREADABLE", xlsxRuim);
check("lista intacta depois do 422", (await call("GET", `/v1/sites/${sv.id}/services`)).json.items.length === 30);
const txt = await up("codigo;descricao\n1;a\n", "x.txt");
check(".txt 415", txt.status === 415 && txt.json.code === "UNSUPPORTED_FILE", txt);
const semArq = await call("PUT", `/v1/sites/${sv.id}/services`, new FormData());
check("sem arquivo 400", semArq.status === 400, semArq);
const acc = await up("Código;Descrição;Unidade\n\"01,1\";\"Concreto; laje\";m³\n", "a.csv");
check("csv com acento no cabeçalho e aspas", acc.status === 200 && acc.json.servicesCount === 1, acc);
const one = (await call("GET", `/v1/sites/${sv.id}/services`)).json.items[0];
check("célula entre aspas com ; preservada", one?.code === "01,1" && one?.description === "Concreto; laje", one);
check("importServices obra inexistente 404", (await (async () => { const f = new FormData(); f.append("file", new Blob(["code,description\n1,a\n"]), "a.csv"); return call("PUT", `/v1/sites/${randomUUID()}/services`, f); })()).status === 404);
done();
