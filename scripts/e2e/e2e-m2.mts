import { randomUUID } from "node:crypto";
import { createRequire } from "node:module";
import { AI, B, DATABASE_URL, ROOT, generateReady } from "./lib.mts";
const pg = createRequire(new URL("apps/api/package.json", ROOT))("pg");
const db = new pg.Client({ connectionString: DATABASE_URL }); await db.connect(); const H = { "X-Api-Key": "dev-key", "X-Timezone": "America/Sao_Paulo" };
let fails = 0; const check = (n: string, ok: boolean, x?: unknown) => { if (!ok) fails++; console.log(ok ? "ok  " : "FAIL", n, ok ? "" : JSON.stringify(x)); };
async function call(m: string, p: string, body?: unknown) { const f = body instanceof FormData; const r = await fetch(B + p, { method: m, headers: { ...H, ...(body && !f ? { "Content-Type": "application/json" } : {}) }, body: body ? (f ? body : JSON.stringify(body)) : undefined }); const t = await r.text(); return { status: r.status, json: t ? JSON.parse(t) : null }; }
const party = { name: "X", taxId: "00" };
const s = (await call("POST", "/v1/sites", { name: "M2", type: "private", address: "R", location: { lat: -19.9, lng: -44 }, client: party, contractor: party, technicalManager: { name: "R", artNumber: "1" } })).json;
const csv = new FormData(); csv.append("file", new Blob(["codigo;descricao;unidade\n02.05;Escavação;m³\n03.01;Concreto laje;m³\n"]), "p.csv"); await call("PUT", `/v1/sites/${s.id}/services`, csv);
const ls = await call("GET", `/v1/sites/${s.id}/services`);
check("listServices", ls.status === 200 && ls.json.items.length === 2 && ls.json.items[0].code === "02.05", ls);
check("listServices search", (await call("GET", `/v1/sites/${s.id}/services?search=laje`)).json.items.length === 1);
check("listServices 404", (await call("GET", `/v1/sites/${randomUUID()}/services`)).status === 404);
const f = new FormData(); f.append("file", new Blob([new Uint8Array(5)], { type: "audio/webm" }), "a"); f.append("kind", "audio"); f.append("source", "microphone"); f.append("capturedAt", new Date().toISOString()); f.append("durationSeconds", "0");
const mid = randomUUID(); await call("PUT", `/v1/media/${mid}`, f);
const today = new Intl.DateTimeFormat("en-CA", { timeZone: H["X-Timezone"] }).format(new Date());
const e = (await call("POST", `/v1/sites/${s.id}/entries`, { id: randomUUID(), capturedAt: new Date().toISOString(), localDate: today, timezone: H["X-Timezone"], audioMediaId: mid })).json;
const ge = await call("GET", `/v1/entries/${e.id}`);
check("getEntry", ge.status === 200 && ge.json.id === e.id && ge.json.audio.id === mid, ge);
check("getEntry 404", (await call("GET", `/v1/entries/${randomUUID()}`)).status === 404);
const g = (await generateReady(s.id, today)).json;
const qid = (await db.query("insert into questions (report_id, kind, text, options) values ($1,'missing_field','Como estava o tempo?', $2) returning id", [g.id, JSON.stringify([{ id: "good", label: "Bom" }])])).rows[0].id;
check("answer opção 200", (await call("POST", `/v1/questions/${qid}/answer`, { optionId: "good" })).json?.status === "answered");
check("answer opção inválida 400", (await call("POST", `/v1/questions/${qid}/answer`, { optionId: "zz" })).status === 400);
check("answer dois campos 400", (await call("POST", `/v1/questions/${qid}/answer`, { text: "a", optionId: "good" })).status === 400);
const spoken = await call("POST", `/v1/questions/${qid}/answer`, { audioMediaId: mid });
check(AI === "off" ? "answer áudio sem IA 409 AI_DISABLED" : "answer áudio 202", AI === "off" ? spoken.status === 409 && spoken.json?.code === "AI_DISABLED" : spoken.status === 202, spoken);
check("answer 404", (await call("POST", `/v1/questions/${randomUUID()}/answer`, { text: "x" })).status === 404);
check("report traz pergunta", (await call("GET", `/v1/reports/${g.id}`)).json.questions.some((q: any) => q.id === qid));
await db.end(); console.log(fails ? `${fails} FALHAS` : "TUDO OK");
